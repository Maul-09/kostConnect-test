datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OWNER
  TENANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String
  name               String
  phone              String?
  role               Role       @default(TENANT)
  mustChangePassword Boolean    @default(true)
  properties         Property[]
  tenantId           String?    @unique
  tenant             Tenant?    @relation(fields: [tenantId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([role])
}

model Property {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  rooms     Room[]
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([city])
}

model Room {
  id           String     @id @default(uuid())
  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomNumber   String
  monthlyPrice Decimal    @db.Decimal(12, 2)
  status       RoomStatus @default(AVAILABLE)
  facilities   String[]   @default([])
  contracts    Contract[]
  createdAt    DateTime   @default(now())

  @@index([propertyId])
  @@index([status])
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  phone     String
  user      User?
  contracts Contract[]
  createdAt DateTime   @default(now())

  @@index([name])
}

model Contract {
  id        String    @id @default(uuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id])
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  startDate DateTime
  endDate   DateTime
  isActive  Boolean   @default(true)
  invoices  Invoice[]
  createdAt DateTime  @default(now())

  @@index([roomId])
  @@index([tenantId])
  @@index([isActive])
}

model Invoice {
  id              String        @id @default(uuid())
  contractId      String
  contract        Contract      @relation(fields: [contractId], references: [id])
  invoiceNumber   String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  dueDate         DateTime
  status          InvoiceStatus @default(UNPAID)
  midtransOrderId String?       @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([contractId])
  @@index([status])
  @@index([dueDate])
}
